generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
  STAFF
}

enum SubmissionType {
  COMPLAINT
  SUGGESTION
  FEEDBACK
}

enum SubmissionStatus {
  PENDING
  REVIEWING
  IN_PROGRESS
  RESOLVED
  // Marked by the office's staff as spam or invalid (with a reason). Left out of
  // every count; an administrator may then delete it for good.
  SPAM
}

enum Priority {
  URGENT
  STANDARD
  LOW
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// How a report reached the office: sent online by the citizen, or typed in by the
// office's staff ("Walk-in report" in the staff portal) for a citizen who came to the
// office, called, wrote a letter or sent a message (Facebook, email).
enum ReportChannel {
  ONLINE
  WALK_IN
  PHONE
  LETTER
  MESSAGE
}

enum AccountStatus {
  PENDING
  ACTIVE
}

enum AccessRequestType {
  STAFF_ACCOUNT
  ADMIN_ACCESS
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  citizenId     String         @unique
  email         String         @unique
  gmail         String?
  mobileNumber  String?
  department    String?
  avatar        String?
  password      String
  role          Role           @default(CITIZEN)
  failedLoginAttempts Int      @default(0)
  lockedUntil   DateTime?
  // Set when the password is reset; sign-ins from before it stop working
  passwordChangedAt DateTime?
  // Self-registered staff stay PENDING until an administrator approves them
  accountStatus AccountStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  submissions   Submission[]
  notifications Notification[]
  accessRequests AccessRequest[]
}

model Submission {
  id          String           @id @default(cuid())
  trackingId  String           @unique
  type        SubmissionType
  status      SubmissionStatus @default(PENDING)
  priority    Priority         @default(STANDARD)
  description String           @db.Text
  contactNumber String?
  email       String?
  address     String?
  citizenDepartment String   @map("category")
  department        String   @default("UNASSIGNED")
  sentiment   Sentiment        @default(NEUTRAL)
  rating      Int?
  reaction    String?
  feedbackTags String?         @db.Text
  userId      String?
  // Why the citizen marked a complaint Urgent: DANGER, MANY_AFFECTED, HEALTH or WORSENING.
  // Only reports sent Oct 14–15, 2026 have one; the form no longer asks.
  urgencyReason String?
  // Resolve-by date, set when the report is submitted: working days for its type and
  // urgency (see SystemSettings). Moves only when the office changes the urgency.
  dueAt       DateTime?
  // When the office's staff first opened the report. The Track page shows feedback
  // as "Read by the office" from then on.
  readAt      DateTime?
  // How it came in, and for one typed in by staff, who typed it in (copied, so the
  // record stays readable if the account is renamed or removed). From Oct 30, 2026.
  channel       ReportChannel  @default(ONLINE)
  encodedById   String?
  encodedByName String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user             User?             @relation(fields: [userId], references: [id])
  location         Location?
  media            Media[]
  aiClassification AIClassification?
  statusLogs       StatusUpdateLog[]
  // Feedback: the client's answers to the ARTA satisfaction form (from Oct 30, 2026)
  csm              CsmResponse?
}

model Location {
  id           String     @id @default(cuid())
  submissionId String     @unique
  latitude     Float
  longitude    Float
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model Media {
  id           String     @id @default(cuid())
  submissionId String
  filePath     String
  fileType     String
  submission   Submission @relation(fields: [submissionId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AIClassification {
  id                  String     @id @default(cuid())
  submissionId        String     @unique
  predictedDepartment String
  confidence          Float
  matchedKeywords     String     @db.Text
  citizenSelected     String?
  adminCorrected      Boolean    @default(false)
  // How urgent the AI found a complaint (utils/urgencyDetector.js) and the words that
  // decided it (JSON). Empty for suggestions and for complaints sent before Oct 16, 2026.
  predictedPriority   Priority?
  urgencyKeywords     String?    @db.Text
  createdAt           DateTime   @default(now())
  submission          Submission @relation(fields: [submissionId], references: [id])
}

model DepartmentChangeLog {
  id             String   @id @default(cuid())
  submissionId   String
  trackingId     String
  changedById    String
  changedByName  String
  changedByRole  String
  fromDepartment String
  toDepartment   String
  reason         String?
  createdAt      DateTime @default(now())
}

// The office's staff changed how urgent a report is (Urgent / Normal / Can wait), with
// the reason the citizen is told, and the resolve-by date before and after. Kept after
// a report is deleted, like office moves (Audit Log).
model PriorityChangeLog {
  id            String    @id @default(cuid())
  submissionId  String
  trackingId    String
  fromPriority  Priority
  toPriority    Priority
  fromDueAt     DateTime?
  toDueAt       DateTime?
  reason        String    @db.Text
  changedById   String
  changedByName String
  changedByRole String
  createdAt     DateTime  @default(now())

  @@index([submissionId])
}

model StatusUpdateLog {
  id            String           @id @default(cuid())
  submissionId  String
  trackingId    String
  status        SubmissionStatus
  note          String?          @db.Text
  updatedById   String
  updatedByName String
  updatedByRole String
  createdAt     DateTime         @default(now())
  submission    Submission       @relation(fields: [submissionId], references: [id])
  // Proof of the work, from the office's staff (see controllers/staff.js)
  photos        StatusPhoto[]
}

// A photo staff attach to a status update to show the work being done or finished.
// Seen by the office's staff and the administrators, never on the citizen's Track page.
model StatusPhoto {
  id          String          @id @default(cuid())
  statusLogId String
  filePath    String
  createdAt   DateTime        @default(now())
  statusLog   StatusUpdateLog @relation(fields: [statusLogId], references: [id], onDelete: Cascade)

  @@index([statusLogId])
}

// A queuing code for one client of an office (staff portal: "New client"). It is
// printed on the client's slip with a QR code that opens the satisfaction form
// (Feedback) for that office. Each code can be used once, until it expires.
model QueueCode {
  id            String    @id @default(cuid())
  code          String    @unique
  department    String
  // What the client came for, when the staff member typed it (e.g. "Birth certificate")
  service       String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  // When the client sent the form with it
  usedAt        DateTime?

  @@index([department, createdAt])
}

// One client's answers to the ARTA Client Satisfaction Measurement form (ARTA
// MC 2022-05), kept with the feedback they sent. The client had a queuing code from
// the office, or is rating a complaint or suggestion the office resolved.
model CsmResponse {
  id            String     @id @default(cuid())
  submissionId  String     @unique
  queueCodeId   String?    @unique
  ratedReportId String?    @unique
  service       String?
  // CITIZEN, BUSINESS or GOVERNMENT (an employee or another agency)
  clientType    String
  // MALE or FEMALE, age and region of residence: all optional
  sex           String?
  age           Int?
  region        String?
  // The Citizen's Charter questions, numbered as on the form: CC1 1–4, CC2 1–5 and
  // CC3 1–4, where the last option is N/A (both are N/A when CC1 is 4).
  cc1           Int
  cc2           Int
  cc3           Int
  // Service quality: 5 Strongly agree, 4 Agree, 3 Neither agree nor disagree,
  // 2 Disagree, 1 Strongly disagree; empty (null) for N/A.
  sqd0          Int?
  sqd1          Int?
  sqd2          Int?
  sqd3          Int?
  sqd4          Int?
  sqd5          Int?
  sqd6          Int?
  sqd7          Int?
  sqd8          Int?
  createdAt     DateTime   @default(now())
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id               String   @id @default("default")
  organizationName String   @default("CIVIX")
  tagline          String   @default("Integrated Citizen Engagement Platform")
  contactEmail     String   @default("admin@civix.gov")
  contactPhone     String   @default("")
  officeAddress    String   @default("") @db.Text
  departmentsJson  String   @db.Text
  // Login security
  lockoutEnabled     Boolean @default(true)
  maxLoginAttempts   Int     @default(5)
  lockoutMinutes     Int     @default(15)
  idleTimeoutEnabled Boolean @default(true)
  idleTimeoutMinutes Int     @default(30)
  // Working days to resolve a report (sets Submission.dueAt at submission): a Normal
  // complaint, a suggestion, and an Urgent or Can wait report
  deadlineComplaintDays  Int @default(7)
  deadlineSuggestionDays Int @default(15)
  deadlineFeedbackDays   Int @default(3)
  deadlineUrgentDays     Int @default(3)
  deadlineLowDays        Int @default(15)
  // Shown to a citizen who marks a report Urgent, next to 911 (e.g. the MDRRMO hotline)
  emergencyHotline   String  @default("")
  // Branding images; null means the bundled default is used
  sealUrl            String?
  heroImageUrl       String?
  // Private address (path segment) of the admin sign-in page
  adminLoginPath     String?
  // Office that receives reports with no office yet and forwards them; null means
  // the Mayor's Office – CRMO (or the first office on the list)
  unassignedOffice   String?
  // Administrators finish each sign-in with a 6-digit code emailed to them
  adminSignInCode    Boolean @default(false)
  updatedAt        DateTime @updatedAt
}

// A staff account request (self-registration) or a staff member's request for
// administrator access, reviewed by an existing administrator. The requester's
// name and email are copied so the history survives if the account is removed.
model AccessRequest {
  id             String              @id @default(cuid())
  type           AccessRequestType
  status         AccessRequestStatus @default(PENDING)
  userId         String?
  fullName       String
  email          String
  department     String?
  reason         String?             @db.Text
  reviewNote     String?             @db.Text
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// One-time code emailed to someone requesting a staff account, proving they own
// the address. Only a hash of the code is kept; the row is removed once used.
model EmailVerification {
  id          String   @id @default(cuid())
  email       String   @unique
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  sentAt      DateTime @default(now())
  // Codes sent since windowStart, for the hourly limit
  sendCount   Int      @default(1)
  windowStart DateTime @default(now())
}

// A report an administrator deleted. Only reports the office's staff had marked as
// spam or invalid can be deleted; this keeps who marked it, why, and who deleted it.
// The citizen's own details are not kept.
model DeletedReport {
  id              String         @id @default(cuid())
  trackingId      String
  type            SubmissionType
  department      String
  reportCreatedAt DateTime
  markedByName    String?
  markedReason    String?        @db.Text
  deletedById     String
  deletedByName   String
  createdAt       DateTime       @default(now())
}

// A code to reset a staff or administrator password ("Forgot password?" on the
// sign-in pages). One per account; only a hash of the code is kept.
model PasswordReset {
  id          String   @id @default(cuid())
  userId      String   @unique
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  sentAt      DateTime @default(now())
  // Codes sent since windowStart, for the hourly limit
  sendCount   Int      @default(1)
  windowStart DateTime @default(now())
}

// Sign-in history (Admin > Audit Log, and each person's profile): sign-ins, failed
// attempts and password changes on the staff and admin pages. Kept for a year.
// name/role are copied when the event happens, so the history stays readable
// after an account is renamed or removed.
// An administrator sign-in waiting for the 6-digit code emailed to them (purpose
// SIGN_IN; the browser holds the ticket), or a code confirming that the sign-in code
// setting may be turned on (purpose ENABLE). One per account; only hashes are kept.
model SignInCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  purpose     String
  ticketHash  String   @unique
  codeHash    String
  attempts    Int      @default(0)
  // When the password was entered (a later password change cancels the sign-in)
  startedAt   DateTime @default(now())
  expiresAt   DateTime
  sentAt      DateTime @default(now())
  // Codes sent since windowStart, for the hourly limit
  sendCount   Int      @default(1)
  windowStart DateTime @default(now())
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  role      String?
  email     String
  portal    String?
  method    String   // PASSWORD | PASSWORD_AND_CODE | GOOGLE | EMAIL_CODE | PROFILE | ADMIN
  outcome   String   // SIGNED_IN | WRONG_PASSWORD | LOCKED | UNKNOWN_ACCOUNT | NOT_APPROVED | WRONG_PAGE | RESET_CODE_SENT | WRONG_CODE | PASSWORD_RESET | PASSWORD_CHANGED | CODE_SENT | WRONG_SIGN_IN_CODE | CODES_ON | CODES_OFF
  newDevice Boolean  @default(false)
  deviceId  String?
  device    String?
  network   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
