# Local-development example. Set production values in your hosting provider's secret manager.
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/civix"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_URL="http://localhost:3000"
PORT=5000

