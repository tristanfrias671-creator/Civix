# Local-development example. Set production values in your hosting provider's secret manager.
DATABASE_URL="mysql://APP_USER:APP_PASSWORD@HOST:4000/civix?sslaccept=strict"
MIGRATION_DATABASE_URL="mysql://MIGRATION_USER:MIGRATION_PASSWORD@HOST:4000/civix?sslaccept=strict"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_URL="http://localhost:3000"
PORT=5000

# Cloud uploads are strongly recommended for hosted deployments.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional integrations
GOOGLE_CLIENT_ID=""
EMAIL_USER=""
EMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
